# Game backend -> private Numista testnet RPCs
NUMISTA_DAEMON_RPC=http://127.0.0.1:48081
NUMISTA_WALLET_RPC=http://127.0.0.1:48083
# Prefer the generated local login file. Keep it out of source control.
NUMISTA_WALLET_LOGIN_FILE=./monero-wallet-rpc.48083.login
NUMISTA_WALLET_RPC_EXE=C:/path/to/numista-windows-x64/monero-wallet-rpc.exe
NUMISTA_ISSUER_WALLET=C:/path/to/issuer-wallet/admin
# Optional protected file containing the wallet password; never commit it.
NUMISTA_WALLET_PASSWORD_FILE=C:/path/to/private/issuer-wallet-password.txt
# Optional if using explicit wallet-RPC credentials instead of the login file.
NUMISTA_RPC_USER=
NUMISTA_RPC_PASS=
NUMISTA_CHAIN_MODE=live
# Testnet is the safe default. Mainnet requires explicit mainnet RPC URLs,
# issuer identity/wallet, treasury address, and currency asset ID; never reuse
# the testnet values below for a live deployment.
NUMISTA_NETWORK=testnet
NUMISTA_CONFIRMATIONS=10
# Estimated launch-price reference only; not live market liquidity or guaranteed redemption.
NUMISTA_LAUNCH_REFERENCE_GBP_PER_NUM=0.25
# Required for mainnet; use the currency asset ID created on the real mainnet.
NUMISTA_CURRENCY_ASSET_ID=
# Public key only. Must match the configured Numista testnet issuer key.
NUMISTA_ISSUER_PUBLIC_KEY=938c1029985ba0e3d91d26f76491abd99dae405dd1caf959a6f5de73a94fe55b
# Mainnet must use its own treasury identity/address and currency asset ID.
NUMISTA_TREASURY_USER=
NUMISTA_TREASURY_ADDRESS=
# Generate a unique random value for each private game backend.
NUMISTA_SESSION_SECRET=replace-with-a-random-secret
# Optional password override for admin vault login. Set privately; no default is provided.
NUMISTA_ADMIN_PASSWORD=

# Stripe checkout stays disabled unless the matching environment switch is enabled.
# Configure these only in the private server environment, never in source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_BASE_URL=https://your-public-domain.example
NUMISTA_ONRAMP_TEST_ENABLED=0
NUMISTA_ONRAMP_LIVE_ENABLED=0
NUMISTA_ONRAMP_MAINNET_READY=0
NUMISTA_ONRAMP_MIN_GBP=1
NUMISTA_ONRAMP_MAX_GBP=250
# Keep the persisted order store private and backed up with the rest of app state.
NUMISTA_ONRAMP_ORDERS_FILE=

# Optional settings for start-numista-node.ps1
NUMISTA_NODE_EXE=C:/path/to/numista-windows-x64/monerod.exe
NUMISTA_NODE_DATA_DIR=C:/Users/your-user/AppData/Local/Numista/numista-testnet-v2
# This testnet has no configured seed peers. Add known Numista peers here.
NUMISTA_NODE_PEERS=
NUMISTA_OUT_PEERS=24
NUMISTA_IN_PEERS=64
# Set your own Numista testnet payout address to enable real block mining.
NUMISTA_MINING_ADDRESS=
NUMISTA_MINING_THREADS=4
