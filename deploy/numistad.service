[Unit]
Description=Numista Testnet Daemon (Monero Fork P2P Seed Node)
After=network.target

[Service]
Type=simple
User=numista
Group=numista
WorkingDirectory=/var/lib/numista
ExecStart=/usr/local/bin/monerod \
    --numista-testnet \
    --data-dir /var/lib/numista/data \
    --p2p-bind-ip 0.0.0.0 \
    --p2p-bind-port 48080 \
    --rpc-bind-ip 127.0.0.1 \
    --rpc-bind-port 48081 \
    --confirm-external-bind \
    --out-peers 32 \
    --in-peers 64 \
    --rpc-max-connections 100 \
    --rpc-max-connections-per-private-ip 100 \
    --start-mining Gt2AXeyZZ6DZn1tpMo6hS77cJ4BBQKTgSRfREqKkBBFcaqbkiEgh4QYMaFg7QfpY8852LfVyRmFfJHZu4CEqFUanCPvZjvN \
    --mining-threads 1 \
    --log-file /var/log/numista/bitmonero.log \
    --max-log-file-size 104857600

Restart=always
RestartSec=10
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
